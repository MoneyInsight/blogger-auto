 "first": {
  "7200583241520880291": "겨울 결로 곰팡이는 창틀을 닦는 것보다 실내 습도와 환기 습관을 바꾸는 쪽이 오래간다.",
  "1092258941810656734": "수도계량기 동파 예방은 한파가 오기 전에 계량기함 안의 보온 상태를 점검하는 것부터 시작한다.",
  "395442701237522540": "보일러 난방비 절약은 외출모드 하나에 기대기보다 집 상황에 맞는 설정을 먼저 확인하는 데서 시작한다.",
  "5286908587429934556": "전기장판 안전 사용법은 전원을 켜기 전에 보관하면서 접히거나 눌린 곳이 없는지 확인하는 것이 먼저다.",
  "5582938525208048660": "가습기 청소 방법의 기본은 물을 보충하는 대신 남은 물을 매일 비우고 물통을 헹구는 것이다.",
  "4050360731530321473": "겨울 이불 세탁 방법은 이불에 붙은 세탁 표시를 먼저 읽고 집 세탁기로 빨 수 있는지 가르는 데서 시작한다.",
  "9133633313091797996": "아이스팩 분리배출 방법은 포장에 적힌 내용물 표시를 먼저 확인하고 종류에 맞춰 버리는 것이다.",
  "13895304036921218": "김장김치 보관 방법은 김치냉장고에 넣기 전에 통에 담는 방법에서 먼저 차이가 난다.",
  "8518294142072879387": "아침 기상 피로가 계속되면 잠든 시간보다 잠들기 전 밤 시간의 습관부터 점검해 볼 만하다.",
  "9201917528121610362": "모니터 눈 피로는 화면을 보는 중간에 눈을 쉬게 하는 습관과 작업 환경을 바꾸는 것으로 줄일 수 있다.",
  "5737862540767382763": "환절기 감기 예방은 집에 들어온 직후 손을 씻는 습관을 가족 모두가 지키는 데서 시작한다.",
  "5289534399642049605": "나트륨 줄이는 식단 습관은 국물 음식처럼 매일 먹는 음식에서 짠맛을 덜어내는 데서 시작한다.",
  "4025317805330329755": "스트레스 푸는 법은 한 번에 없애려 하기보다 쌓이기 전에 조금씩 풀어 두는 습관을 만드는 쪽이 오래간다.",
  "538952953374529382": "속쓰림 줄이는 습관은 늦은 저녁과 야식을 먹는 방식부터 바꾸는 데서 시작한다.",
  "6628525784210337339": "종합소득세 경비 증빙은 3만 원을 넘는 지출이라면 세금계산서·카드 전표·현금영수증 같은 적격증빙을 챙겨야 비용으로 인정받기 쉽습니다.",
  "6591416990931232955": "자영업자 비상금은 생활비 몇 개월치라는 공식보다 돈의 역할을 나눠 단계별로 정하는 쪽이 현실에 맞습니다.",
  "4628758484946321788": "고정비 줄이는 법은 매달 나가는 돈을 세 갈래로 나눠 적어 보는 것에서 시작합니다.",
  "4406653486372706154": "사업자 카드 분리는 사업 지출과 생활비를 서로 다른 카드로 결제하는 것만으로도 정산이 훨씬 쉬워집니다.",
  "5063907365795861983": "아이 용돈 통장 만들기는 금액보다 규칙을 먼저 정해 두는 쪽이 오래갑니다.",
  "6677292262612079163": "금리인하요구권 신청은 대출을 받은 뒤 소득이나 신용 상태가 나아졌을 때 금융회사에 금리를 낮춰 달라고 요구하는 절차입니다.",
  "1828890727131678068": "겨울철 자동차 점검은 기온이 영하로 내려가기 전인 11월에 한 번 끝내 두는 것이 가장 수월하다.",
  "7977848583700542233": "블랙아이스 운전은 눈이 오지 않은 날에도 새벽 도로가 얼어 있을 수 있다고 보고 속도를 미리 줄이는 데서 시작한다.",
  "6176181034134493746": "자동차 정기검사 기간은 우편 안내문을 기다리지 않아도 만료일을 직접 조회해 확인할 수 있다.",
  "5708736975279352300": "전기차 겨울 주행거리는 기온이 낮아지면 줄어들기 마련이며, 충전과 히터 사용 습관으로 줄어드는 폭을 덜 수 있다.",
  "5292630506526381936": "교통 과태료 조회는 고지서를 기다리지 않고 경찰청 교통민원24(이파인)에서 먼저 확인할 수 있다.",
  "2908281235817435003": "접촉사고 대처 순서는 잘잘못을 따지기 전에 2차사고를 막는 안전 확보가 먼저다.",
  "9208441790564563023": "자동차보험 갱신 전 확인할 것은 작년 조건 그대로 누르기 전에 다시 봐야 하는 가입 조건들이다.",
  "3770465912168445275": "야간 운전 요령은 해가 짧아지는 계절일수록 시야를 확보하는 습관을 먼저 들이는 데 있다.",
  "230135384845487671": "연비 좋아지는 운전 습관은 경제운전 원칙을 주유 기록으로 확인해 가며 하나씩 들이면 된다.",
  "3329841907257994214": "스마트폰 저장공간 부족 해결은 사진을 지우기 전에 어디에 용량이 쓰이는지부터 확인하는 순서로 하면 된다.",
  "514986132182713113": "갤럭시 배터리 설정은 세 가지만 손봐도 저녁까지 충전 없이 버티는 날이 늘어난다.",
  "9136260285704158231": "스미싱 문자 대처는 링크를 누른 직후 몇 가지를 순서대로 확인하는 것으로 피해를 줄일 수 있다.",
  "1964974572784783308": "아이폰 배터리 설정은 네 곳만 확인해도 오후에 충전기를 찾는 일이 줄어든다.",
  "5103573145966061740": "윈도우11 노트북이 느릴 때는 새로 사기 전에 시작 프로그램 정리부터 해 보면 된다.",
  "1859587321217383843": "집 와이파이가 느릴 때는 공유기를 바꾸기 전에 놓인 위치부터 옮겨 보는 것이 먼저다.",
  "5614392790962140598": "에너지바우처 신청은 12월 31일까지이므로 대상 가구인지부터 확인해 두어야 한다.",
  "8504985354055028410": "기초연금 신청 방법은 만 65세 이상이면서 소득인정액이 선정기준액 이하인지 확인한 뒤 접수하는 순서다.",
  "7883260781462782818": "청년월세 지원은 월세로 따로 사는 청년에게 월 최대 20만 원을 지원하는 제도이며, 요건을 충족해야 받을 수 있다.",
  "1399734792052618551": "내일배움카드 신청 자격은 폭넓게 열려 있지만 제외 대상이 따로 정해져 있어 먼저 확인해야 한다.",
  "7087446227776807211": "주거급여 신청 방법은 가구의 소득인정액이 기준 이하인지 확인하는 것에서 시작한다.",
  "1006181457122644628": "노인일자리 신청 방법은 참여하려는 유형에 따라 자격 기준이 달라지므로 유형부터 고르면 된다.",
  "5416847919913814312": "실업급여 신청 방법은 고용보험 가입 기간 180일 조건을 채웠는지 확인하고 퇴사 후 12개월 안에 신청하는 것이 기본이다.",
  "498264860838831938": "아이 독서 습관 만들기는 책을 읽으라고 시키는 대신 매일 밤 짧게 함께 읽는 것부터 시작하면 된다.",
  "1358495783799669351": "아이 스마트폰 시간 정하기는 부모가 통보하는 규칙보다 아이와 함께 정해 눈에 보이게 해 둔 약속이 오래간다.",
  "8191603863531922500": "아이 잠자리 루틴은 잠들기 전에 하는 일의 순서를 매일 똑같이 반복하는 것에서 만들어진다.",
  "8912423565633696933": "형제 싸움 중재는 누가 먼저 했는지 판결하는 대신 부모가 건네는 말을 바꾸는 것에서 시작한다.",
  "7436728703763231406": "아이 편식 고치는 법은 한 입을 강요하는 대신 식탁에서 부담 없이 접하는 횟수를 늘리는 데서 시작한다.",
  "5956743574204232129": "아이 집안일 시키기는 작은 역할 하나를 정해 주는 것부터 하면 된다.",
  "2220785833211614338": "아이 숙제 습관은 끝내라고 다그치기보다 시작하는 과정을 쉽게 만들어 주는 데서 잡힌다.",
  "4695502517089262574": "아이 방학 일과표는 시간 단위로 빽빽하게 짜기보다 하루를 세 칸으로 나누는 것만으로 충분하다.",
  "1140866812411016033": "아이 집안 안전 점검은 어른 눈높이가 아니라 아이 눈높이로 몸을 낮춰 방마다 둘러보는 것이 요령이다."
 },
